POSTGRES_USER=mediturnos
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=mediturnos

APP_ENV=development
DATABASE_URL=postgresql+psycopg://mediturnos:cambiar_esta_contrasena@db:5432/mediturnos
TRUST_PROXY_HEADERS=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_LOGIN_ATTEMPTS=15
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=3
APP_TIMEZONE=America/Argentina/Buenos_Aires
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PORT=8000

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador

DEMO_SEED_ENABLED=false
DEMO_ADMIN_EMAIL=admin.demo@mediturnos.com.ar
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_RESET_PASSWORD=false
DEMO_PROFESSIONAL_EMAIL=profesional.demo@mediturnos.com.ar
DEMO_PROFESSIONAL_PASSWORD=
DEMO_PROFESSIONAL_RESET_PASSWORD=false

JWT_SECRET_KEY=reemplazar_por_una_clave_larga_y_aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
APPOINTMENT_ACTION_SECRET=replace-with-a-random-secret-at-least-32-characters
EMAIL_PROVIDER=in_memory
# En producción: clave secreta de Resend y remitente de un dominio verificado.
RESEND_API_KEY=
EMAIL_FROM=
OBJECT_STORAGE_PROVIDER=fake
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGNED_UPLOAD_TTL_SECONDS=600
R2_PRESIGNED_DOWNLOAD_TTL_SECONDS=300

MERCADO_PAGO_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_PRUEBA
MERCADO_PAGO_WEBHOOK_SECRET=TU_CLAVE_SECRETA_DEL_WEBHOOK

# Facturación SaaS mediante Mercado Pago Suscripciones. Estas credenciales son
# del entorno desplegado; en sandbox usar APP_USR del mismo Seller Test User.
# En production usar APP_USR de la cuenta real. No mezclar credenciales entre entornos.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...
MERCADOPAGO_ENV=sandbox
# Solo se utiliza en sandbox; corresponde al Buyer Test User.
MERCADOPAGO_TEST_PAYER_EMAIL=
MERCADOPAGO_WEBHOOK_SECRET=
STUDY_ACCESS_SECRET=
STUDY_ACCESS_TOKEN_TTL_SECONDS=2592000
